  "lens.softness": 0.85,
  "lens.sharpen": 0.55,
  "lens.bloom": 0.45,
  "lens.vignette": 0.25,
  "tone.exposure": 1.25,
  "tone.contrast": 1.2,
  "tone.blackCrush": 0.04,
  "tone.gamma": 1.1,
  "tone.exposureDrift": 0.6,
  "night.amount": 1.0,
  "night.color": [
   1.0,
   1.0,
   1.0
  ],
  "night.gain": 1.35,
  "night.irWeights": [
   0.62,
   0.32,
   0.06
  ],
  "night.hotspot": 0.85,
  "night.hotspotSize": 0.78,
  "tape.jitter": 0.3,
  "tape.ghost": 0.12,
