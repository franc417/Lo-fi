    },
    {
     "path": "lens.softness",
     "from": 0.4,
     "to": 1.6
    },
    {
     "path": "tape.ghost",
     "from": 0.0,
     "to": 0.3
    },
    {
     "path": "tape.dropouts",
     "from": 0.0,
     "to": 0.5,
     "curve": "quad"
    }
   ]
  }
 ],
 "hd": {
  "w": 640,
  "h": 480
 }
}