{
 "schema": 1,
 "id": "cine",
 "name": "Cine",
 "virtualResolution": {
  "w": 480,
  "h": 360
 },
 "upscale": "linear",
 "exportScale": 2,
 "overlay": {
  "style": "none"
 },
 "params": {
  "lens.letterbox": 0.2,
  "tone.saturation": 0.8,
  "tone.contrast": 1.25,
  "tone.shadowTint": [
   -0.02,
   0.03,
   0.07
  ],
  "tone.highlightTint": [
   0.07,
   0.03,
   -0.03
  ],
  "tone.blackCrush": 0.05,
  "lens.vignette": 0.45,
  "digital.grain": 0.12,
  "lens.softness": 0.5,
  "lens.bloom": 0.5
 },
 "macros": [
  {
   "id": "wear",
   "label": "Wear",
   "default": 0.5,
   "targets": [
    {
     "path": "digital.grain",
     "from": 0.04,
     "to": 0.35
    },
    {
     "path": "lens.softness",
     "from": 0.2,
     "to": 1.2
    }
   ]
  }
 ],
 "hd": {
  "w": 640,
  "h": 480
 },
 "keep": [
  "lens.letterbox"
 ]
}