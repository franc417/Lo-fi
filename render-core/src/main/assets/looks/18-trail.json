{
 "schema": 1,
 "id": "trail",
 "name": "Trail",
 "virtualResolution": {
  "w": 480,
  "h": 360
 },
 "upscale": "linear",
 "exportScale": 2,
 "overlay": {
  "style": "handycam"
 },
 "params": {
  "tape.ghost": 0.82,
  "tone.exposure": 1.05,
  "lens.bloom": 0.3,
  "lens.softness": 0.5,
  "tone.saturation": 1.1,
  "digital.grain": 0.06,
  "lens.vignette": 0.15
 },
 "macros": [
  {
   "id": "wear",
   "label": "Wear",
   "default": 0.5,
   "targets": [
    {
     "path": "tape.ghost",
     "from": 0.6,
     "to": 0.88
    },
    {
     "path": "digital.grain",
     "from": 0.02,
     "to": 0.2
    }
   ]
  }
 ],
 "hd": {
  "w": 640,
  "h": 480
 },
 "keep": [
  "tape.ghost"
 ]
}